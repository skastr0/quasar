#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bun_version="$(sed -n 's/.*"packageManager": *"bun@\([^"]*\)".*/\1/p' package.json)"
if [[ -z "$bun_version" ]]; then
  printf '[setup] error: package.json must declare packageManager as bun@<version>\n' >&2
  exit 1
fi

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/setup.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

# Shared runtime first: Tailscale, the published Quasar CLI, harnesses, and
# universal CLIs. The published binary is ~/.local/bin/quasar. Workspace
# tooling stays `bun run` / `quasar-dev` and is never installed as `quasar`.
orb_setup="$(locate_orb_setup)" || {
  printf '[setup] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
printf '[setup] Using shared runtime at %s\n' "$orb_setup"
bash "${orb_setup}/bin/setup.sh"
export PATH="$HOME/.local/bin:$PATH"

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
bun_bin="$BUN_INSTALL/bin/bun"
toolchain_started=$SECONDS
if [[ ! -x "$bun_bin" ]] || [[ "$("$bun_bin" --version)" != "$bun_version" ]]; then
  printf '[setup] Installing Bun %s\n' "$bun_version"
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v${bun_version}"
else
  printf '[setup] Bun %s is already installed\n' "$bun_version"
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$bun_bin" "$HOME/.local/bin/bun"
ln -sfn "$BUN_INSTALL/bin/bunx" "$HOME/.local/bin/bunx"
export PATH="$HOME/.local/bin:$PATH"
printf '[setup] Bun toolchain ready in %ss\n' "$((SECONDS - toolchain_started))"

packages=()
command -v sqlite3 >/dev/null 2>&1 || packages+=(sqlite3)
if (( ${#packages[@]} > 0 )); then
  printf '[setup] Installing system packages: %s\n' "${packages[*]}"
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
else
  printf '[setup] System packages already installed\n'
fi

profile_marker="# Quasar orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Quasar orb toolchain
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi

dependencies_started=$SECONDS
printf '[setup] Installing workspace dependencies\n'
bun install --frozen-lockfile --cpu='*' --os='*'
printf '[setup] Workspace dependencies ready in %ss\n' "$((SECONDS - dependencies_started))"

# Keep the published CLI and the workspace binary distinct. install:dev links
# dist/quasar as quasar-dev and leaves ~/.local/bin/quasar alone.
printf '[setup] Complete\n'
